# --- LLM provider ---
# gemini | none
#   gemini (default): plan with Gemini (needs GEMINI_API_KEY below).
#   none:             always use demo mode - the app still traverses the
#                     real graph with the real tools, but the plan is
#                     deterministic and no API calls are made.
LLM_PROVIDER=gemini

# Google Gemini - get a key at https://aistudio.google.com/apikey
GEMINI_API_KEY=
# gemini-2.0-flash is retired; 3.8-flash is current. List what your key
# can use with:
#   python -c "from google import genai,os; [print(m.name) for m in genai.Client(api_key=os.environ['GEMINI_API_KEY']).models.list()]"
# Free-tier quota is PER MODEL, so a 429 on one model does not mean the
# key is dead. Find a model with quota left:
#   python -m scripts.pick_gemini_model
GEMINI_MODEL=gemini-3.5-flash

# --- FalkorDB ---
# Docker / self-hosted: leave the defaults. FalkorDB Cloud: set the host,
# port and password the console gives you.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# Graph backend selection
#   auto (default): try FalkorDB, fall back to the in-memory dev graph
#                   when the server is unreachable.
#   true:           always use the in-memory dev graph (no FalkorDB needed).
#   false:          always use FalkorDB; fail loudly if it is unreachable.
USE_DEV_GRAPH=auto

# --- Embeddings ---
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIM=384

# --- Tenants & transport ---
DEFAULT_TENANT=org_acme
TOOL_TRANSPORT=inprocess          # inprocess | mcp

# --- Agent safety ---
MAX_TOOL_STEPS=8

# --- Public demo safeguards ---
RATE_LIMIT_PER_MIN=20
DEMO_READ_ONLY=false