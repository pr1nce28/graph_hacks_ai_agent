# --- LLM provider ---
# anthropic | gemini | auto | none
#   auto (default): prefer Anthropic, then Gemini, then deterministic
#                   demo mode when no key is set.
#   none:           always use demo mode (useful for offline demos).
LLM_PROVIDER=auto

# Anthropic (used when LLM_PROVIDER=anthropic or auto)
ANTHROPIC_API_KEY=
MODEL=claude-sonnet-4-5

# Google Gemini (used when LLM_PROVIDER=gemini, or by auto if no Anthropic key)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash

# --- FalkorDB ---
# Docker / self-hosted: leave the defaults. FalkorDB Cloud: set the host,
# port and password the console gives you.
FALKORDB_HOST=localhost
FALKORDB_PORT=6379
FALKORDB_USERNAME=
FALKORDB_PASSWORD=

# Graph backend selection
#   auto (default): try FalkorDB, fall back to the in-memory dev graph
#                   when the server is unreachable.
#   true:           always use the in-memory dev graph (no FalkorDB needed).
#   false:          always use FalkorDB; fail loudly if it is unreachable.
USE_DEV_GRAPH=auto

# --- Embeddings ---
EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBED_DIM=384

# --- Tenants & transport ---
DEFAULT_TENANT=org_acme
TOOL_TRANSPORT=inprocess          # inprocess | mcp

# --- Agent safety ---
MAX_TOOL_STEPS=8

# --- Public demo safeguards ---
RATE_LIMIT_PER_MIN=20
DEMO_READ_ONLY=false